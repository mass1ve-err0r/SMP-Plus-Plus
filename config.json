{
    "app": {
        "number_of_threads": 0,
        "enable_session": false,

        "document_root": "./",
        "home_page": "index.html",
        "use_implicit_page": false,
        "upload_path": "uploads",

        "file_types": [
            "html",
            "js",
            "css",
            "svg",
            "ico",
            "png",
            "webp",
            "xml"
        ],

        "log": {
            "use_spdlog": false,
            "logfile_base_name": "smp",
            "log_size_limit": 100000000,
            "max_files": 10,
            "log_level": "INFO",
            "display_local_time": true
        },

        "run_as_daemon": false,
        "handle_sig_term": true,
        "relaunch_on_error": false,

        "use_sendfile": true,
        "use_gzip": true,
        "use_brotli": false,
        "gzip_static": false,
        "br_static": false,

        "static_files_cache_time": -1,

        "idle_connection_timeout": 60,
        "keepalive_requests": 0,
        "pipelining_requests": 0,

        "server_header_field": "smp++",
        "enable_server_header": true,
        "enable_date_header": true,

        "client_max_body_size": "4M",
        "client_max_memory_body_size": "256K",
        "client_max_websocket_message_size": "128K",

        "reuse_port": true,

        "enabled_compressed_request": false,
        "enable_request_stream": false,

        "json_parser_stack_limit": 1000,
        "enable_unicode_escaping_in_json": true,
        "float_precision_in_json": {
            "precision": 0,
            "precision_type": "significant"
        },

        "load_dynamic_views": false
    },
    "plugins": [
        {
            "name": "drogon::plugin::AccessLogger",
            "dependencies": [],
            "config": {
                "use_spdlog": false,
                "log_path": "",
                "log_file": "access.log",
                "log_size_limit": 100000000,
                "use_local_time": true
            }
        }
    ],
    "custom_config": {}
}
